# ── SiteBot Backend Konfiguration ──
# Kopiere diese Datei nach `.env` und passe die Werte an.

NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# Öffentliche Basis-URL des Backends — speist ALLE nach außen sichtbaren Links
# (Widget-Snippet, Vorschau-Link, Portal-/Logo-/Datenschutz-URL, Stripe-Redirects).
# In PRODUKTION setzen, sonst erscheinen "localhost"-Links. Ohne sie: http://localhost:PORT.
# PUBLIC_BACKEND_URL=https://fragio.at

# Pfad zur SQLite-DB (Default: <repo>/data/sitebot.sqlite)
# DATABASE_PATH=./data/sitebot.sqlite

# 32-Byte-Secret zum Verschlüsseln der Kunden-API-Keys (AES-256-GCM).
# In PRODUKTION zwingend setzen! Erzeugen z. B. mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# APP_SECRET=

# ── Betreiber-Zugang (einziger Admin, keine Selbstregistrierung) ──
# Mit diesem Key meldest du dich im Admin-Dashboard (/admin) an. In PROD Pflicht.
ADMIN_API_KEY=dev-admin-key
ADMIN_EMAIL=admin@sitebot.local

# ── Zahlungen (Stripe) — Default AUS: manueller Ablauf ──
# false: Tarifklick im Portal speichert eine Anfrage + benachrichtigt dich.
# true: startet Stripe-Checkout (dann STRIPE_SECRET_KEY + STRIPE_WEBHOOK_SECRET setzen).
STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── Standard-Engine: Claude Haiku 4.5 über deinen Anthropic-Key ──
DEFAULT_ENGINE=anthropic
# Dein Operator-Key. PFLICHT, damit die Standard-Engine antworten kann.
# Bei Anthropic ein hartes monatliches Budget-Limit setzen!
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-haiku-4-5-20251001

# ── Embeddings: lokal In-Process (KEIN Ollama, kein API-Key) ──
# WICHTIG: Dieses Modell muss zu den Relevanz-Schwellen in rag/answer.ts passen
# (kalibriert für e5-small). e5 nutzt automatisch "query:"/"passage:"-Präfixe.
EMBEDDING_MODEL=Xenova/multilingual-e5-small
EMBEDDING_DIM=384

# ── Trial-Modus: eigener Trial-Key (optional; fällt sonst auf ANTHROPIC_API_KEY zurück) ──
# TRIAL_ANTHROPIC_API_KEY=
TRIAL_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── Bring-your-own-Key (Kunde hinterlegt eigenen Key im Dashboard) ──
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# ── Auto-Update: Zeitplan für den wöchentlichen Recrawl (node-cron) ──
# RECRAWL_CRON=0 3 * * 0

# ── E-Mail-Versand (SMTP, generisch) — leer lassen = nur Log-Stub ──
# Funktioniert mit jedem Anbieter (eigenes Postfach, Mailbox.org, Gmail-App-Passwort,
# Resend/Postmark per SMTP). Verbindung testen: GET /api/admin/smtp-test
# SMTP_HOST=smtp.mailbox.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=no-reply@deine-domain.at
# SMTP_PASS=
# SMTP_FROM=SiteBot <no-reply@deine-domain.at>

# ── Backup: täglicher SQLite-Snapshot nach data/backups/ ──
# BACKUP_CRON=0 4 * * *
# BACKUP_KEEP_DAYS=14

# ── Rechnungen: Firmenkopf des Betreibers (Platzhalter bis Gewerbe/Steuerberater steht) ──
# INVOICE_ISSUER_NAME=
# INVOICE_ISSUER_ADDRESS=
# INVOICE_ISSUER_VAT=
# INVOICE_CURRENCY=EUR

# ── Ollama (OPTIONAL, nur wenn DEFAULT_ENGINE=ollama) ──
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=phi3
